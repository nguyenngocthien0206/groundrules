table 'Revenue by district'
	lineageTag: 4f51cd81-a094-4f4a-af69-5f8469c2db57

	/// metric: net_revenue v2 (owner: finance). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Net revenue by district' = SELECTEDVALUE('Revenue by district'[net_revenue])
		formatString: #,##0
		lineageTag: 75b99a9a-95ed-43e6-b5dc-157b10c1b495

	/// metric: gross_margin v1 (owner: finance). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Gross margin by district' = SELECTEDVALUE('Revenue by district'[gross_margin])
		formatString: #,##0
		lineageTag: e0035e04-d77c-4c5f-a768-18a73a1d45f1

	column Month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: fa75aa8d-ac4b-4b43-8a3d-6f3080d1ca4a
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column 'District code'
		dataType: string
		lineageTag: 53f760d8-ae31-4c9d-81ea-b2ed47afd05f
		summarizeBy: none
		sourceColumn: district_code

	column District
		dataType: string
		lineageTag: 0d11f2ab-7aef-44f3-9f05-30ec25973975
		summarizeBy: none
		sourceColumn: district

	column net_revenue
		dataType: double
		isHidden
		lineageTag: 031c88f0-5ad0-4e2e-bf77-dc019c48def3
		summarizeBy: none
		sourceColumn: net_revenue

		annotation SummarizationSetBy = User

	column gross_margin
		dataType: double
		isHidden
		lineageTag: dc438757-9f48-4eca-8fc9-8d427832f167
		summarizeBy: none
		sourceColumn: gross_margin

		annotation SummarizationSetBy = User

	column 'Data through'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 6ee63bdd-95e0-4ae3-916c-f9128e1c8b64
		summarizeBy: none
		sourceColumn: data_through

		annotation UnderlyingDateTimeDataType = Date

	/// True for the current month: its numbers run only to Data through.
	column 'Month to date'
		dataType: boolean
		lineageTag: 66424ea9-8aca-40a0-9971-d1b9afd8786c
		summarizeBy: none
		sourceColumn: is_month_to_date

	column 'As of'
