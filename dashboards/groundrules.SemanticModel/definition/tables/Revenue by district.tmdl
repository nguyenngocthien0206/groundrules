		lineageTag: eb1b3487-2cc0-4dd8-9934-486aaf46c5a3
		summarizeBy: none
		sourceColumn: as_of

		annotation UnderlyingDateTimeDataType = Date

	column Caveats
		dataType: string
		lineageTag: 78cdc826-f615-4458-aaf9-1eb4bdddebac
		summarizeBy: none
		sourceColumn: caveats

	partition 'Revenue by district' = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportFolder & "\revenue_by_district_month.parquet"))
				in
				    Source

