table 'Revenue by category'
	lineageTag: 5e1e83a9-5b6c-43e6-87c5-e377b6fe67cc

	/// metric: net_revenue v2 (owner: finance). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Net revenue by category' = SELECTEDVALUE('Revenue by category'[net_revenue])
		formatString: #,##0
		lineageTag: 098847eb-ba6e-4a34-b232-9ae4e2a9bfd0

	/// metric: gross_margin v1 (owner: finance). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
