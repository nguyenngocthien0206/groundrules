table 'Stock by store'
	lineageTag: 2c96f048-b41e-4428-9406-15e338d33de5

	/// metric: available_stock v3 (owner: supply_chain_ops). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Available stock by store' = SELECTEDVALUE('Stock by store'[available_stock])
		formatString: #,##0
		lineageTag: 7e0fc982-ae61-4ad5-97cd-e849a8efcb77

	/// metric: near_expiry_value v1 (owner: supply_chain_ops). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Near-expiry value by store' = SELECTEDVALUE('Stock by store'[near_expiry_value])
		formatString: #,##0
		lineageTag: a390cac6-0c6c-4828-9d2f-66c7bfaa2f32

	/// metric: days_of_cover v1 (owner: supply_chain_ops). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Days of cover by store' = SELECTEDVALUE('Stock by store'[days_of_cover])
		formatString: 0.0
		lineageTag: 3da2c60b-5cde-4002-9ed2-8dfa34c904c3

