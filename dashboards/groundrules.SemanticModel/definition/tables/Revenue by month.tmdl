table 'Revenue by month'
	lineageTag: 8db5ed35-2476-4e1d-9ba9-709f08d51df3

	/// metric: net_revenue v2 (owner: finance). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Net revenue by month' = SELECTEDVALUE('Revenue by month'[net_revenue])
		formatString: #,##0
		lineageTag: 7fe7bf02-edf9-4798-9f49-6429576f3df9

	/// metric: gross_margin v1 (owner: finance). Shows the exported certified value;
	/// a total that was not exported stays blank on purpose.
	measure 'Gross margin by month' = SELECTEDVALUE('Revenue by month'[gross_margin])
		formatString: #,##0
		lineageTag: b23c25a0-7886-4fd3-b2b9-a2bbde5fac24

