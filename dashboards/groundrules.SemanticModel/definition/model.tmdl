model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ExportFolder", "Revenue by month", "Revenue by district", "Revenue by category", "Sell-through by store", "Stock by store", "Stock by category", "Metric versions"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table 'Revenue by month'
ref table 'Revenue by district'
ref table 'Revenue by category'
ref table 'Sell-through by store'
ref table 'Stock by store'
ref table 'Stock by category'
ref table 'Metric versions'

ref cultureInfo en-US

